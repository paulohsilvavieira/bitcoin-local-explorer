rpcuser=${RPC_USER}
rpcpassword=${RPC_PASSWORD}

server=1
rest=1

rpcallowip=0.0.0.0/0

# Necessário para o explorer resolver inputs/outputs de qualquer transação
# (getrawtransaction por txid, independente de idade/wallet).
