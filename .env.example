# Domínio público atribuído ao serviço `proxy` (porta 80) no Coolify.
# Não é consumido pelo compose — é só documentação de qual domínio apontar.
DOMAIN=btc.explorer.mybitcoin.ptechsistemas.com

RPC_USER=admin
# Gere com: openssl rand -hex 24
RPC_PASSWORD=
# Enviado pelas apps que consomem o RPC no header X-RPC-Token. Gere com: openssl rand -hex 32
RPC_TOKEN=

# Variáveis do auto-mining (mesmos defaults do local.env).
WALLET_NAME=bitcoin-wallet-regtest
MINING_INTERVAL=10
TX_MIN_AMOUNT=0.0001
TX_MAX_AMOUNT=0.01
TX_MIN_FEE_RATE=1
TX_MAX_FEE_RATE=20
TX_MIN_BALANCE=0.01
